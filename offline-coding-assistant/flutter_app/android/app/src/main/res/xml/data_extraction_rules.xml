<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device-transfer rules. Only the SQLite database is
     included; the bundled model file is intentionally excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
